# Required: your Anthropic API key (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Model used for analysis + translation. Opus gives the best literary nuance; Sonnet is faster/cheaper.
PONTE_MODEL=claude-sonnet-5-5

# Port for the local Ponte server
PORT=8787

# Comma-separated origins allowed to call the API from a browser.
# Add your Framer domains, e.g. https://lalityakrishnan.in,https://*.framer.app,https://*.framer.website
PONTE_ALLOWED_ORIGINS=http://localhost:8787,https://*.framer.app,https://*.framer.website,https://framer.com,https://*.framercanvas.com

# Abuse limits for the public visitor endpoint
PONTE_MAX_SEGMENTS=400
PONTE_MAX_CHARS=60000
PONTE_RATE_LIMIT_PER_MIN=20

# Set to 1 to run without an API key: returns "[hi] Hello"-style pseudo-translations
# so you can test the Framer wiring. (Same as `npm run mock`.)
PONTE_MOCK=0
